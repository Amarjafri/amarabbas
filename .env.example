# ── Admin auth ────────────────────────────────────────────────────────────
ADMIN_PASSWORD=
AUTH_SECRET=                 # openssl rand -base64 32

# ── Content persistence (admin writes commit back to GitHub) ──────────────
GITHUB_TOKEN=                # fine-grained PAT, Contents: Read and write, this repo only
GITHUB_REPO=owner/repo
GITHUB_BRANCH=main

# ── Image uploads ─────────────────────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=       # from the Vercel dashboard → Storage → Blob

# ── Contact form ──────────────────────────────────────────────────────────
RESEND_API_KEY=
CONTACT_TO_EMAIL=amarjafri1472@gmail.com

# ── Site ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://your-domain.com
